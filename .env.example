# Copia este archivo como .env (o defínelas en Vercel → Settings → Environment Variables).
# Ninguna es obligatoria para ver la web: sin ellas las funciones degradan con elegancia.

# /api/top40 — historial de emisión de AzuraCast (permiso "View Station Reports")
AZURACAST_API_KEY=
AZURACAST_BASE=https://radio.radiobendicion.cl
AZURACAST_STATION=radio-star-online

# /api/encuesta — Redis por REST (Vercel KV / Upstash). Sin ellas, recuento simulado.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa si Upstash se contrata por fuera de Vercel:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
