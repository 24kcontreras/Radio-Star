# Caché local del corrector de nombres: sólo evita repetir consultas al
# catálogo entre ejecuciones. Se regenera solo y no aporta nada al repositorio.
scripts/.cache-busquedas.json

# Variables de entorno (AZURACAST_API_KEY). Nunca deben acabar en el repo.
.env
.env.*
!.env.example

.vercel/
node_modules/

# Archivos fuente sin optimizar (maqueta, vídeos e imágenes originales).
# La web sólo usa sus derivados en assets/img/ (ver docs/OPERACION.md §2 bis).
originales/
